# Public template only. Replace placeholders in a private environment file.
# Never overwrite an existing .env or .env.local with this template.
# Never commit API keys, service-role keys, or other credentials.

# Supabase: required for authentication and persisted task breakdowns.
NEXT_PUBLIC_SUPABASE_URL=<your-supabase-project-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>

# OpenRouter: server-only API key.
# Primary: DeepSeek V4.1 Flash 1017 (low-cost paid model).
# Fallback: DeepSeek R1 (free), attempted through OpenRouter model routing.
# The primary is restricted to this model or a free model override. The
# fallback must remain a :free model so an outage cannot silently add cost.
# OpenRouter provider fallback is separate: it can retry eligible providers.
OPENROUTER_API_KEY=<server-only-openrouter-api-key>
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_FALLBACK_MODEL=liquid/lfm-2.5-2.6b:free
# Optional attribution headers; leave blank unless configured.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# Optional video narration generation. Keep this server/local-only.
ELEVENLABS_API_KEY=<server-only-elevenlabs-api-key>
ELEVENLABS_VOICE_ID=<selected-calm-neutral-voice-id>
ELEVENLABS_MODEL=eleven_v4

# Razorpay: configure before enabling payments; secrets are server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=<your-public-razorpay-key-id>
RAZORPAY_KEY_SECRET=<server-only-razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<your-razorpay-webhook-secret>
RAZORPAY_PRO_PLAN_ID_MONTHLY=<your-monthly-plan-id>
RAZORPAY_PRO_PLAN_ID_YEARLY=<your-yearly-plan-id>
# Optional hosted payment links.
RAZORPAY_PRO_MONTHLY_PAYMENT_LINK=
RAZORPAY_PRO_YEARLY_PAYMENT_LINK=

# Resend: configure for application email; server-only.
RESEND_API_KEY=<server-only-resend-api-key>

# Public application and support configuration.
NEXT_PUBLIC_APP_URL=<your-app-url>
NEXT_PUBLIC_SUPPORT_EMAIL=<your-support-email>
NEXT_PUBLIC_PRIVACY_EMAIL=<your-privacy-email>
# Optional official profiles and search verification tokens.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
