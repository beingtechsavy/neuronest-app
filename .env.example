# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ⚠️ CRITICAL: Service Role Key - NEVER expose this in client-side code
# This key bypasses Row Level Security and should ONLY be used in:
# - Server-side API routes (src/app/api/*)
# - Node.js scripts (never in browser)
# - Vercel environment variables (encrypted)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site URL (set to your production domain)
NEXT_PUBLIC_APP_URL=https://www.neuronest.work
NEXT_PUBLIC_SUPPORT_EMAIL=support@neuronest.work
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@neuronest.work
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_search_console_verification_token
NEXT_PUBLIC_BING_SITE_VERIFICATION=your_bing_webmaster_verification_token
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/your-neuronest-page
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-neuronest-page

# Azure OpenAI Configuration
# Get these from: https://portal.azure.com
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name

# Razorpay Configuration (Payment Gateway)
# Get these from: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ⚠️ CRITICAL SECURITY: Razorpay Webhook Secret - REQUIRED for production
# Get this from: https://dashboard.razorpay.com/app/webhooks
# Without this, webhook signature verification will fail and webhooks will be rejected
# This prevents attackers from sending fake payment webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Optional hosted checkout/payment-link fallback values
RAZORPAY_PRO_PLAN_ID_MONTHLY=plan_placeholder_monthly
RAZORPAY_PRO_PLAN_ID_YEARLY=plan_placeholder_yearly
RAZORPAY_PRO_MONTHLY_PAYMENT_LINK=https://rzp.io/l/placeholder-monthly
RAZORPAY_PRO_YEARLY_PAYMENT_LINK=https://rzp.io/l/placeholder-yearly

# Resend Email Service
# Get this from: https://resend.com/api-keys
# ⚠️ REQUIRED for production - email functionality will be disabled without this
RESEND_API_KEY=your_resend_api_key

# Optional: Paddle Configuration (Alternative Payment Gateway)
# NEXT_PUBLIC_PADDLE_VENDOR_ID=your_vendor_id
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_client_token
# PADDLE_API_KEY=your_api_key
# PADDLE_WEBHOOK_SECRET=your_webhook_secret
