# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ⚠️ CRITICAL: Service Role Key - NEVER expose this in client-side code
# This key bypasses Row Level Security and should ONLY be used in:
# - Server-side API routes (src/app/api/*)
# - Node.js scripts (never in browser)
# - Vercel environment variables (encrypted)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site URL (set to your production domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Azure OpenAI Configuration
# Get these from: https://portal.azure.com
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name

# Razorpay Configuration (Payment Gateway)
# Get these from: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Resend Email Service
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# Optional: Paddle Configuration (Alternative Payment Gateway)
# NEXT_PUBLIC_PADDLE_VENDOR_ID=your_vendor_id
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_client_token
# PADDLE_API_KEY=your_api_key
# PADDLE_WEBHOOK_SECRET=your_webhook_secret
